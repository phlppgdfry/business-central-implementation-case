<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p2p_tobe" targetNamespace="https://kalvaert.example/bpmn" exporter="business-central-implementation-case/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_p2p_tobe">
    <bpmn:documentation>Aankoop in Business Central: workflow, ontvangst per regel en factuur uit ontvangstregels.</bpmn:documentation>
    <bpmn:participant id="Pool_p2p_tobe" name="Kalvaert (straks)" processRef="Process_p2p_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_p2p_tobe" name="TO-BE — aankoop in Business Central" isExecutable="false">
    <bpmn:laneSet id="LaneSet_p2p_tobe">
      <bpmn:lane id="Lane_p2p_tobe_ak" name="Aankoper">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_tobe_zv" name="Zaakvoerder">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_tobe_bc" name="Business Central">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_tobe_mag" name="Magazijn">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_tobe_fin" name="Boekhouding">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Voorraad laag of klantorder">
      <bpmn:outgoing>Flow_p2p_tobe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Aankooporder; prijs uit ingelezen prijslijst">
      <bpmn:documentation>AK-02, procesaanpassing: vast sjabloon via configuratiepakket.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_tobe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Boven €5.000?" default="Flow_p2p_tobe_4">
      <bpmn:documentation>AK-01, goedkeuringsworkflow.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_tobe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_p2p_tobe_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Goedkeuren in de workflow">
      <bpmn:incoming>Flow_p2p_tobe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Vrijgeven en versturen">
      <bpmn:incoming>Flow_p2p_tobe_4</bpmn:incoming>
      <bpmn:incoming>Flow_p2p_tobe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Ontvangst per regel met de werkelijke hoeveelheid">
      <bpmn:documentation>AK-03, standaard.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_tobe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="t5" name="Inkomende factuur via Peppol in de werklijst">
      <bpmn:documentation>EF-02.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_tobe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="t6" name="Factuur uit ontvangstregels; verschil = vraag aan aankoop">
      <bpmn:documentation>AK-04, standaard.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_tobe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_tobe_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Betaald">
      <bpmn:incoming>Flow_p2p_tobe_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p2p_tobe_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_3" sourceRef="g1" targetRef="t2" name="ja" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_4" sourceRef="g1" targetRef="t3" name="nee" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_5" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_6" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_7" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_8" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_p2p_tobe_9" sourceRef="t6" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_p2p_tobe">
    <bpmndi:BPMNPlane id="Plane_p2p_tobe" bpmnElement="Collab_p2p_tobe">
      <bpmndi:BPMNShape id="Pool_p2p_tobe_di" bpmnElement="Pool_p2p_tobe" isHorizontal="true"><dc:Bounds x="20" y="20" width="1450" height="650" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_tobe_ak_di" bpmnElement="Lane_p2p_tobe_ak" isHorizontal="true"><dc:Bounds x="50" y="20" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_tobe_zv_di" bpmnElement="Lane_p2p_tobe_zv" isHorizontal="true"><dc:Bounds x="50" y="150" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_tobe_bc_di" bpmnElement="Lane_p2p_tobe_bc" isHorizontal="true"><dc:Bounds x="50" y="280" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_tobe_mag_di" bpmnElement="Lane_p2p_tobe_mag" isHorizontal="true"><dc:Bounds x="50" y="410" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_tobe_fin_di" bpmnElement="Lane_p2p_tobe_fin" isHorizontal="true"><dc:Bounds x="50" y="540" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="107" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="425" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="400" y="374" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="542" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="692" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="842" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="992" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1142" y="571" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1332" y="587" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1300" y="627" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_1_di" bpmnElement="Flow_p2p_tobe_1"><di:waypoint x="168" y="85" /><di:waypoint x="242" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_2_di" bpmnElement="Flow_p2p_tobe_2"><di:waypoint x="300" y="119" /><di:waypoint x="300" y="345" /><di:waypoint x="425" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_3_di" bpmnElement="Flow_p2p_tobe_3"><di:waypoint x="450" y="320" /><di:waypoint x="450" y="215" /><di:waypoint x="542" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="456" y="197" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_4_di" bpmnElement="Flow_p2p_tobe_4"><di:waypoint x="475" y="345" /><di:waypoint x="692" y="345" /><bpmndi:BPMNLabel><dc:Bounds x="481" y="327" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_5_di" bpmnElement="Flow_p2p_tobe_5"><di:waypoint x="600" y="249" /><di:waypoint x="600" y="345" /><di:waypoint x="692" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_6_di" bpmnElement="Flow_p2p_tobe_6"><di:waypoint x="750" y="379" /><di:waypoint x="750" y="475" /><di:waypoint x="842" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_7_di" bpmnElement="Flow_p2p_tobe_7"><di:waypoint x="900" y="441" /><di:waypoint x="900" y="345" /><di:waypoint x="992" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_8_di" bpmnElement="Flow_p2p_tobe_8"><di:waypoint x="1050" y="379" /><di:waypoint x="1050" y="605" /><di:waypoint x="1142" y="605" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_tobe_9_di" bpmnElement="Flow_p2p_tobe_9"><di:waypoint x="1258" y="605" /><di:waypoint x="1332" y="605" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
