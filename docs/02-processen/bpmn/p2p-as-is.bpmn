<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p2p_asis" targetNamespace="https://kalvaert.example/bpmn" exporter="business-central-implementation-case/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_p2p_asis">
    <bpmn:documentation>Hoe een aankoop vandaag loopt, uit workshop W-AK (fictief).</bpmn:documentation>
    <bpmn:participant id="Pool_p2p_asis" name="Kalvaert (vandaag)" processRef="Process_p2p_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_p2p_asis" name="AS-IS — aankoop in TradeDesk" isExecutable="false">
    <bpmn:laneSet id="LaneSet_p2p_asis">
      <bpmn:lane id="Lane_p2p_asis_ak" name="Aankoper">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_asis_zv" name="Zaakvoerder">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_asis_mag" name="Magazijn">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p2p_asis_bk" name="Boekhoudkantoor">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Voorraad laag of klantorder">
      <bpmn:outgoing>Flow_p2p_asis_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Bestelling in TradeDesk, prijs uit pdf-prijslijst">
      <bpmn:documentation>Prijslijsten van leveranciers worden overgetypt (AK-02).</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_asis_1</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_asis_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t2" name="Mondeling akkoord boven €5.000, soms achteraf">
      <bpmn:documentation>Geen spoor van wie wat goedkeurde (AK-01).</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_asis_2</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_asis_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Ontvangst op papier, tekorten in een schrift">
      <bpmn:documentation>AK-03.</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_asis_3</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_asis_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t4" name="Factuur inboeken zonder koppeling met de ontvangst">
      <bpmn:documentation>Verschillen vallen pas op als de leverancier aanmaant (AK-04).</bpmn:documentation>
      <bpmn:incoming>Flow_p2p_asis_4</bpmn:incoming>
      <bpmn:outgoing>Flow_p2p_asis_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Betaald">
      <bpmn:incoming>Flow_p2p_asis_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p2p_asis_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_p2p_asis_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_p2p_asis_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_p2p_asis_4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_p2p_asis_5" sourceRef="t4" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_p2p_asis">
    <bpmndi:BPMNPlane id="Plane_p2p_asis" bpmnElement="Collab_p2p_asis">
      <bpmndi:BPMNShape id="Pool_p2p_asis_di" bpmnElement="Pool_p2p_asis" isHorizontal="true"><dc:Bounds x="20" y="20" width="1000" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_asis_ak_di" bpmnElement="Lane_p2p_asis_ak" isHorizontal="true"><dc:Bounds x="50" y="20" width="970" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_asis_zv_di" bpmnElement="Lane_p2p_asis_zv" isHorizontal="true"><dc:Bounds x="50" y="150" width="970" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_asis_mag_di" bpmnElement="Lane_p2p_asis_mag" isHorizontal="true"><dc:Bounds x="50" y="280" width="970" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_p2p_asis_bk_di" bpmnElement="Lane_p2p_asis_bk" isHorizontal="true"><dc:Bounds x="50" y="410" width="970" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="107" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="392" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="542" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="692" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="882" y="457" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="850" y="497" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_p2p_asis_1_di" bpmnElement="Flow_p2p_asis_1"><di:waypoint x="168" y="85" /><di:waypoint x="198" y="85" /><di:waypoint x="198" y="85" /><di:waypoint x="242" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_asis_2_di" bpmnElement="Flow_p2p_asis_2"><di:waypoint x="300" y="119" /><di:waypoint x="300" y="215" /><di:waypoint x="392" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_asis_3_di" bpmnElement="Flow_p2p_asis_3"><di:waypoint x="450" y="249" /><di:waypoint x="450" y="345" /><di:waypoint x="542" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_asis_4_di" bpmnElement="Flow_p2p_asis_4"><di:waypoint x="600" y="379" /><di:waypoint x="600" y="475" /><di:waypoint x="692" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_p2p_asis_5_di" bpmnElement="Flow_p2p_asis_5"><di:waypoint x="808" y="475" /><di:waypoint x="882" y="475" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
