<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_o2c_tobe" targetNamespace="https://kalvaert.example/bpmn" exporter="business-central-implementation-case/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_o2c_tobe">
    <bpmn:documentation>Hoe een order loopt in Business Central: standaard en configuratie, één extensie (VK-10). Teal = gebeurt automatisch in BC.</bpmn:documentation>
    <bpmn:participant id="Pool_o2c_tobe" name="Kalvaert (straks)" processRef="Process_o2c_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_o2c_tobe" name="TO-BE — order-to-cash in Business Central" isExecutable="false">
    <bpmn:laneSet id="LaneSet_o2c_tobe">
      <bpmn:lane id="Lane_o2c_tobe_inst" name="Installateur">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_tobe_bd" name="Binnendienst">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_tobe_bc" name="Business Central">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_tobe_mag" name="Magazijn">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_tobe_fin" name="Boekhouding">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Bestelling per mail of telefoon">
      <bpmn:outgoing>Flow_o2c_tobe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Verkooporder ingeven">
      <bpmn:incoming>Flow_o2c_tobe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="t2" name="Prijs uit prijslijst of klantuitzondering">
      <bpmn:documentation>VK-01, configuratie: prijslijsten per klantkortingsgroep.</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="t3" name="Bijdrageregel onder het artikel">
      <bpmn:documentation>VK-10, de enige extensie: bc/apps/removal-fee.</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Binnen kredietlimiet?" default="Flow_o2c_tobe_5">
      <bpmn:documentation>VK-05: waarschuwing; nieuwe klanten betalen vooraf.</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_o2c_tobe_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t4" name="Vooraf laten betalen of vrijgeven na akkoord">
      <bpmn:incoming>Flow_o2c_tobe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Verzenden, ook gedeeltelijk">
      <bpmn:documentation>VK-04, standaard; de rest blijft open op de order. De bijdrage verzendt mee (U9).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_5</bpmn:incoming>
      <bpmn:incoming>Flow_o2c_tobe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t6" name="Factuur boeken: omzet, btw, dimensies">
      <bpmn:documentation>Boekingsgroepen en dimensies bepalen de rekeningen (boekingsmatrix).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t7" name="E-document via Peppol">
      <bpmn:documentation>EF-01, app van een access point.</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_9</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="t8" name="CODA inlezen, afpunten op gestructureerde mededeling">
      <bpmn:documentation>FIN-03, standaard.</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_tobe_10</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_tobe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Betaald en afgepunt">
      <bpmn:incoming>Flow_o2c_tobe_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o2c_tobe_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_5" sourceRef="g1" targetRef="t5" name="ja" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_6" sourceRef="g1" targetRef="t4" name="nee" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_7" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_8" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_9" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_10" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_o2c_tobe_11" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_o2c_tobe">
    <bpmndi:BPMNPlane id="Plane_o2c_tobe" bpmnElement="Collab_o2c_tobe">
      <bpmndi:BPMNShape id="Pool_o2c_tobe_di" bpmnElement="Pool_o2c_tobe" isHorizontal="true"><dc:Bounds x="20" y="20" width="1600" height="650" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_tobe_inst_di" bpmnElement="Lane_o2c_tobe_inst" isHorizontal="true"><dc:Bounds x="50" y="20" width="1570" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_tobe_bd_di" bpmnElement="Lane_o2c_tobe_bd" isHorizontal="true"><dc:Bounds x="50" y="150" width="1570" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_tobe_bc_di" bpmnElement="Lane_o2c_tobe_bc" isHorizontal="true"><dc:Bounds x="50" y="280" width="1570" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_tobe_mag_di" bpmnElement="Lane_o2c_tobe_mag" isHorizontal="true"><dc:Bounds x="50" y="410" width="1570" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_tobe_fin_di" bpmnElement="Lane_o2c_tobe_fin" isHorizontal="true"><dc:Bounds x="50" y="540" width="1570" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="107" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="392" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="542" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="725" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="700" y="374" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="842" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="842" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="992" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1142" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1292" y="571" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1482" y="587" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1450" y="627" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_1_di" bpmnElement="Flow_o2c_tobe_1"><di:waypoint x="168" y="85" /><di:waypoint x="198" y="85" /><di:waypoint x="198" y="215" /><di:waypoint x="242" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_2_di" bpmnElement="Flow_o2c_tobe_2"><di:waypoint x="300" y="249" /><di:waypoint x="300" y="345" /><di:waypoint x="392" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_3_di" bpmnElement="Flow_o2c_tobe_3"><di:waypoint x="508" y="345" /><di:waypoint x="542" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_4_di" bpmnElement="Flow_o2c_tobe_4"><di:waypoint x="658" y="345" /><di:waypoint x="725" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_5_di" bpmnElement="Flow_o2c_tobe_5"><di:waypoint x="750" y="370" /><di:waypoint x="750" y="475" /><di:waypoint x="842" y="475" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="457" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_6_di" bpmnElement="Flow_o2c_tobe_6"><di:waypoint x="750" y="320" /><di:waypoint x="750" y="215" /><di:waypoint x="842" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="197" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_7_di" bpmnElement="Flow_o2c_tobe_7"><di:waypoint x="900" y="249" /><di:waypoint x="900" y="441" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_8_di" bpmnElement="Flow_o2c_tobe_8"><di:waypoint x="958" y="475" /><di:waypoint x="978" y="475" /><di:waypoint x="978" y="345" /><di:waypoint x="992" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_9_di" bpmnElement="Flow_o2c_tobe_9"><di:waypoint x="1108" y="345" /><di:waypoint x="1142" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_10_di" bpmnElement="Flow_o2c_tobe_10"><di:waypoint x="1200" y="379" /><di:waypoint x="1200" y="605" /><di:waypoint x="1292" y="605" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_tobe_11_di" bpmnElement="Flow_o2c_tobe_11"><di:waypoint x="1408" y="605" /><di:waypoint x="1482" y="605" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
