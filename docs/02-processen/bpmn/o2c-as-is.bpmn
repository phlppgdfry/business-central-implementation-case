<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_o2c_asis" targetNamespace="https://kalvaert.example/bpmn" exporter="business-central-implementation-case/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_o2c_asis">
    <bpmn:documentation>Hoe een order vandaag loopt, uit workshop W-VK (fictief). Elke stap doet een mens; de knelpunten staan in de documentatie per taak.</bpmn:documentation>
    <bpmn:participant id="Pool_o2c_asis" name="Kalvaert (vandaag)" processRef="Process_o2c_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_o2c_asis" name="AS-IS — order-to-cash in TradeDesk" isExecutable="false">
    <bpmn:laneSet id="LaneSet_o2c_asis">
      <bpmn:lane id="Lane_o2c_asis_inst" name="Installateur">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_asis_bd" name="Binnendienst">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_asis_mag" name="Magazijn">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_o2c_asis_bk" name="Boekhoudkantoor">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Bestelling per mail of telefoon">
      <bpmn:outgoing>Flow_o2c_asis_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Order in TradeDesk, prijs overtypen uit notitie">
      <bpmn:documentation>420 prijsafspraken als vrije tekst; fouten en afhankelijk van één medewerker (VK-01).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_asis_1</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t2" name="Bijdrage met de hand toevoegen">
      <bpmn:documentation>Wordt geregeld vergeten; Kalvaert betaalt de bijdrage dan zelf (VK-10).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_asis_2</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Picken van papier, rest als backorder op papier">
      <bpmn:documentation>Backorders alleen op papier (VK-04).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_asis_3</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t4" name="Factuur maken in TradeDesk">
      <bpmn:incoming>Flow_o2c_asis_4</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Dezelfde factuur nog eens in het Peppol-portaal">
      <bpmn:documentation>Dubbel werk sinds de Peppol-plicht van 1 januari 2026 (EF-01).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_asis_5</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Import in WinBooks, CODA afpunten">
      <bpmn:incoming>Flow_o2c_asis_6</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t7" name="Marge per vestiging uit twee exports in Excel">
      <bpmn:documentation>Alleen maandelijks, na twee exports (FIN-04).</bpmn:documentation>
      <bpmn:incoming>Flow_o2c_asis_7</bpmn:incoming>
      <bpmn:outgoing>Flow_o2c_asis_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="e1" name="Maand afgesloten">
      <bpmn:incoming>Flow_o2c_asis_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o2c_asis_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_6" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_o2c_asis_8" sourceRef="t7" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_o2c_asis">
    <bpmndi:BPMNPlane id="Plane_o2c_asis" bpmnElement="Collab_o2c_asis">
      <bpmndi:BPMNShape id="Pool_o2c_asis_di" bpmnElement="Pool_o2c_asis" isHorizontal="true"><dc:Bounds x="20" y="20" width="1450" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_asis_inst_di" bpmnElement="Lane_o2c_asis_inst" isHorizontal="true"><dc:Bounds x="50" y="20" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_asis_bd_di" bpmnElement="Lane_o2c_asis_bd" isHorizontal="true"><dc:Bounds x="50" y="150" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_asis_mag_di" bpmnElement="Lane_o2c_asis_mag" isHorizontal="true"><dc:Bounds x="50" y="280" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_o2c_asis_bk_di" bpmnElement="Lane_o2c_asis_bk" isHorizontal="true"><dc:Bounds x="50" y="410" width="1420" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="107" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="392" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="542" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="692" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="842" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="992" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1142" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1332" y="457" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1300" y="497" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_1_di" bpmnElement="Flow_o2c_asis_1"><di:waypoint x="168" y="85" /><di:waypoint x="198" y="85" /><di:waypoint x="198" y="215" /><di:waypoint x="242" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_2_di" bpmnElement="Flow_o2c_asis_2"><di:waypoint x="358" y="215" /><di:waypoint x="392" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_3_di" bpmnElement="Flow_o2c_asis_3"><di:waypoint x="450" y="249" /><di:waypoint x="450" y="345" /><di:waypoint x="542" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_4_di" bpmnElement="Flow_o2c_asis_4"><di:waypoint x="600" y="311" /><di:waypoint x="600" y="215" /><di:waypoint x="692" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_5_di" bpmnElement="Flow_o2c_asis_5"><di:waypoint x="808" y="215" /><di:waypoint x="842" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_6_di" bpmnElement="Flow_o2c_asis_6"><di:waypoint x="900" y="249" /><di:waypoint x="900" y="475" /><di:waypoint x="992" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_7_di" bpmnElement="Flow_o2c_asis_7"><di:waypoint x="1108" y="475" /><di:waypoint x="1142" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_o2c_asis_8_di" bpmnElement="Flow_o2c_asis_8"><di:waypoint x="1258" y="475" /><di:waypoint x="1332" y="475" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
